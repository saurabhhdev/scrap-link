# These values belong to the alternate API in server/src/ and are not used by
# the active root app command (`npm run server`).
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/scraplink
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
