NODE_ENV=development
PORT=8787
MONGO_URI=mongodb://127.0.0.1:27017/scraplink
# Optional fallback resolvers when the machine's DNS cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=
CLIENT_ORIGIN=http://localhost:5173

# Set a unique secret (at least 32 characters in production).
JWT_SECRET=
# Optional first-admin bootstrap. Existing administrator passwords are never overwritten.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_MINUTES=480
SAMPLE_PASSWORD=ScrapLink@Customer26
SAMPLE_COLLECTOR_PASSWORD=ScrapLink@Collector26
SAMPLE_RECYCLER_PASSWORD=ScrapLink@Recycler26
SAMPLE_ADMIN_PASSWORD=ScrapLink@Admin26
# Set true only when intentionally seeding an isolated sample database.
SAMPLE_MODE=false

# These values are compiled into the frontend to fill the public sample accounts.
# Keep them aligned with the SAMPLE_* values above; they are not secret credentials.
VITE_SAMPLE_PASSWORD=ScrapLink@Customer26
VITE_SAMPLE_COLLECTOR_PASSWORD=ScrapLink@Collector26
VITE_SAMPLE_RECYCLER_PASSWORD=ScrapLink@Recycler26
VITE_SAMPLE_ADMIN_PASSWORD=ScrapLink@Admin26

# Vite browser API base; blank means same-origin /api.
VITE_API_URL=
# Vite development proxy target.
VITE_API_PROXY_TARGET=http://localhost:8787
